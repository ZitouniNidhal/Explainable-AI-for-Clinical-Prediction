{# Cellule 1
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from pathlib import Path
import warnings
warnings.filterwarnings('ignore')

# Configuration
BASE_DIR = Path('..')
DATA_DIR = BASE_DIR / 'data/raw/brca_tcga'
PANCAN_DIR = BASE_DIR / 'data/raw/pancan'
PROCESSED_DIR = BASE_DIR / 'data/processed'
FIGURES_DIR = BASE_DIR / 'figures'

for d in [PROCESSED_DIR, FIGURES_DIR]:
    d.mkdir(parents=True, exist_ok=True)

print("="*70)
print("EXPLORATION COMPLÈTE - BRCA TCGA + PANCAN")
print("="*70)

# Cellule 2 : Données Cliniques
print("\n📋 [1/8] DONNÉES CLINIQUES")

clinical_file = DATA_DIR / 'data_clinical_patient'
if clinical_file.exists():
    # Détecter automatiquement le séparateur
    with open(clinical_file, 'r') as f:
        first_lines = [f.readline() for _ in range(5)]
    
    skip_rows = 0
    for i, line in enumerate(first_lines):
        if line.startswith('#'):
            skip_rows = i + 1
    
    clinical_df = pd.read_csv(clinical_file, sep='\t', skiprows=skip_rows)
    print(f"✅ Shape: {clinical_df.shape}")
    print(f"Colonnes: {len(clinical_df.columns)}")
    
    # Visualisation
    fig, axes = plt.subplots(2, 3, figsize=(16, 10))
    
    # Age
    if 'AGE' in clinical_df.columns:
        clinical_df['AGE'].hist(ax=axes[0,0], bins=30, color='skyblue', edgecolor='black')
        axes[0,0].set_title('Distribution de l\'âge')
    
    # Stade
    if 'TUMOR_STAGE' in clinical_df.columns:
        clinical_df['TUMOR_STAGE'].value_counts().plot(kind='bar', ax=axes[0,1], color='lightcoral')
        axes[0,1].set_title('Stade tumoral')
        axes[0,1].tick_params(axis='x', rotation=45)
    
    # Grade
    if 'GRADE' in clinical_df.columns:
        clinical_df['GRADE'].value_counts().sort_index().plot(kind='bar', ax=axes[0,2], color='lightgreen')
        axes[0,2].set_title('Grade histologique')
    
    # ER Status
    if 'ER_STATUS' in clinical_df.columns:
        clinical_df['ER_STATUS'].value_counts().plot(kind='pie', ax=axes[1,0], autopct='%1.1f%%')
        axes[1,0].set_title('Statut ER')
    
    # HER2 Status
    if 'HER2_STATUS' in clinical_df.columns:
        clinical_df['HER2_STATUS'].value_counts().plot(kind='pie', ax=axes[1,1], autopct='%1.1f%%')
        axes[1,1].set_title('Statut HER2')
    
    # OS Status
    if 'OS_STATUS' in clinical_df.columns:
        clinical_df['OS_STATUS'].value_counts().plot(kind='bar', ax=axes[1,2], color='orange')
        axes[1,2].set_title('Statut de survie')
    
    plt.tight_layout()
    plt.savefig(FIGURES_DIR / '01_clinical_overview.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    # Sauvegarde
    clinical_df.to_csv(PROCESSED_DIR / 'clinical_raw.csv', index=False)
else:
    print("❌ data_clinical_patient non trouvé")

# Cellule 3 : mRNA Seq v2 RSEM
print("\n🧬 [2/8] mRNA SEQ V2 RSEM")

mrna_file = DATA_DIR / 'data_mrna_seq_v2_rsem'
if mrna_file.exists():
    mrna_df = pd.read_csv(mrna_file, sep='\t')
    print(f"✅ Shape: {mrna_df.shape}")
    
    # Transposer
    mrna_t = mrna_df.set_index('Hugo_Symbol').drop('Entrez_Gene_Id', axis=1, errors='ignore').T
    print(f"Transposé: {mrna_t.shape}")
    
    # Distribution
    plt.figure(figsize=(12, 5))
    
    plt.subplot(1, 2, 1)
    sample_means = mrna_t.mean(axis=1)
    plt.hist(sample_means, bins=50, color='purple', alpha=0.7)
    plt.title('Moyenne d\'expression par échantillon')
    
    plt.subplot(1, 2, 2)
    gene_vars = mrna_t.var(axis=0).sort_values(ascending=False)
    plt.plot(range(len(gene_vars)), gene_vars.values, color='red')
    plt.title('Variance par gène (log scale)')
    plt.yscale('log')
    
    plt.tight_layout()
    plt.savefig(FIGURES_DIR / '01_mrna_overview.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    # Top 20 gènes variables
    plt.figure(figsize=(10, 6))
    gene_vars.head(20).plot(kind='barh', color='teal')
    plt.title('Top 20 gènes les plus variables')
    plt.tight_layout()
    plt.savefig(FIGURES_DIR / '01_top_variable_genes.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    mrna_t.to_csv(PROCESSED_DIR / 'mrna_transposed.csv')
else:
    print("❌ data_mrna_seq_v2_rsem non trouvé")

# Cellule 4 : mRNA Agilent Microarray
print("\n🧬 [3/8] mRNA AGILENT MICROARRAY")

mrna_agilent = DATA_DIR / 'data_mrna_agilent_microarray'
if mrna_agilent.exists():
    agilent_df = pd.read_csv(mrna_agilent, sep='\t')
    print(f"✅ Shape: {agilent_df.shape}")
    
    # Comparer avec RSEM si disponible
    if 'mrna_t' in locals():
        print(f"  - RSEM: {mrna_t.shape[0]} échantillons")
        print(f"  - Agilent: {agilent_df.shape[1]-2} échantillons")
    
    agilent_df.to_csv(PROCESSED_DIR / 'mrna_agilent_raw.csv', index=False)
else:
    print("❌ data_mrna_agilent_microarray non trouvé")

# Cellule 5 : Méthylation HM450
print("\n🔬 [4/8] MÉTHYLATION HM450")

meth_file = DATA_DIR / 'data_methylation_hm450'
if meth_file.exists():
    meth_df = pd.read_csv(meth_file, sep='\t')
    print(f"✅ Shape: {meth_df.shape}")
    
    # Transposer
    meth_t = meth_df.set_index('Composite Element REF').T
    print(f"Transposé: {meth_t.shape}")
    
    # Distribution β-values
    plt.figure(figsize=(10, 5))
    meth_values = meth_t.values.flatten()
    meth_values = meth_values[~np.isnan(meth_values)]
    plt.hist(meth_values, bins=100, color='green', alpha=0.7)
    plt.title('Distribution β-values méthylation')
    plt.xlabel('β-value (0=non méthylé, 1=complètement méthylé)')
    plt.savefig(FIGURES_DIR / '01_methylation_distribution.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    meth_t.to_csv(PROCESSED_DIR / 'methylation_transposed.csv')
else:
    print("❌ data_methylation_hm450 non trouvé")

# Cellule 6 : CNA (Copy Number Alteration)
print("\n🧬 [5/8] COPY NUMBER ALTERATION (CNA)")

cna_file = DATA_DIR / 'data_cna'
if cna_file.exists():
    cna_df = pd.read_csv(cna_file, sep='\t')
    print(f"✅ Shape: {cna_df.shape}")
    
    # Transposer
    cna_t = cna_df.set_index('Hugo_Symbol').T
    print(f"Transposé: {cna_t.shape}")
    
    # Distribution des valeurs CNA
    plt.figure(figsize=(10, 5))
    cna_values = cna_t.values.flatten()
    plt.hist(cna_values, bins=50, color='blue', alpha=0.7)
    plt.title('Distribution des valeurs CNA')
    plt.xlabel('Valeur CNA (-2=del, 0=normal, +2=amp)')
    plt.savefig(FIGURES_DIR / '01_cna_distribution.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    cna_t.to_csv(PROCESSED_DIR / 'cna_transposed.csv')
else:
    print("❌ data_cna non trouvé")

# Cellule 7 : Mutations
print("\n🧬 [6/8] MUTATIONS")

mut_file = DATA_DIR / 'data_mutations'
if mut_file.exists():
    mut_df = pd.read_csv(mut_file, sep='\t')
    print(f"✅ Shape: {mut_df.shape}")
    print(f"Colonnes: {mut_df.columns.tolist()}")
    
    # Top gènes mutés
    if 'Hugo_Symbol' in mut_df.columns:
        plt.figure(figsize=(10, 6))
        mut_df['Hugo_Symbol'].value_counts().head(20).plot(kind='barh', color='darkred')
        plt.title('Top 20 gènes mutés')
        plt.tight_layout()
        plt.savefig(FIGURES_DIR / '01_top_mutated_genes.png', dpi=300, bbox_inches='tight')
        plt.show()
    
    # Types de mutations
    if 'Variant_Classification' in mut_df.columns:
        plt.figure(figsize=(10, 6))
        mut_df['Variant_Classification'].value_counts().plot(kind='bar', color='coral')
        plt.title('Types de mutations')
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        plt.savefig(FIGURES_DIR / '01_mutation_types.png', dpi=300, bbox_inches='tight')
        plt.show()
    
    # Créer matrice binaire
    if 'Tumor_Sample_Barcode' in mut_df.columns and 'Hugo_Symbol' in mut_df.columns:
        mut_matrix = mut_df.pivot_table(
            index='Tumor_Sample_Barcode',
            columns='Hugo_Symbol',
            values='Variant_Classification',
            aggfunc='count',
            fill_value=0
        )
        mut_matrix.to_csv(PROCESSED_DIR / 'mutation_matrix.csv')
        print(f"Matrice mutations: {mut_matrix.shape}")
    
    mut_df.to_csv(PROCESSED_DIR / 'mutations_raw.csv', index=False)
else:
    print("❌ data_mutations non trouvé")

# Cellule 8 : Protéomique / Phosphoprotéomique
print("\n🧪 [7/8] PROTÉOMIQUE")

prot_file = DATA_DIR / 'data_protein_quantification'
phospho_file = DATA_DIR / 'data_phosphoprotein_quantification'

for name, file in [('Protein', prot_file), ('PhosphoProtein', phospho_file)]:
    if file.exists():
        df = pd.read_csv(file, sep='\t')
        print(f"✅ {name}: {df.shape}")
        df.to_csv(PROCESSED_DIR / f'{name.lower()}_raw.csv', index=False)
    else:
        print(f"❌ {file.name} non trouvé")

# Cellule 9 : PANCAN
print("\n🌍 [8/8] DONNÉES PANCAN")

pancan_file = list(PANCAN_DIR.glob('EBPlusPlusAdjustPANCAN*.tsv'))
if pancan_file:
    pancan_df = pd.read_csv(pancan_file[0], sep='\t', index_col=0)
    print(f"✅ PANCAN Shape: {pancan_df.shape}")
    
    # Extraire types de cancer
    sample_ids = pd.Series(pancan_df.index)
    cancer_types = sample_ids.str.extract(r'TCGA-(?P<cancer>\w{2})')
    cancer_map = {
        'BR': 'BRCA', 'LU': 'LUAD', 'LA': 'LUSC', 'PR': 'PRAD',
        'CO': 'COAD', 'RE': 'READ', 'BL': 'BLCA', 'GB': 'GBM',
        'HN': 'HNSC', 'KI': 'KIRC', 'OV': 'OV', 'PA': 'PAAD',
        'TH': 'THCA', 'ST': 'STAD', 'LI': 'LIHC', 'LU': 'LUNG',
        'SK': 'SKCM', 'CE': 'CESC', 'ES': 'ESCA', 'PA': 'PAAD'
    }
    cancer_types['CANCER'] = cancer_types['cancer'].map(cancer_map)
    
    # Distribution
    plt.figure(figsize=(14, 6))
    cancer_counts = cancer_types['CANCER'].value_counts()
    cancer_counts.plot(kind='bar', color='navy')
    plt.title('Distribution des types de cancer (PANCAN)')
    plt.xticks(rotation=45, ha='right')
    plt.tight_layout()
    plt.savefig(FIGURES_DIR / '01_pancan_distribution.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    # Filtrer BRCA
    brca_mask = cancer_types['CANCER'] == 'BRCA'
    pancan_brca = pancan_df[brca_mask.values]
    print(f"Échantillons BRCA dans PANCAN: {len(pancan_brca)}")
    
    # Comparer avec BRCA TCGA
    if 'mrna_t' in locals():
        print(f"  - BRCA TCGA mRNA: {mrna_t.shape[0]} échantillons")
        print(f"  - PANCAN BRCA: {len(pancan_brca)} échantillons")
    
    pancan_brca.to_csv(PROCESSED_DIR / 'pancan_brca_expression.csv')
else:
    print("❌ Fichier PANCAN non trouvé")

# Cellule 10 : Résumé
print("\n" + "="*70)
print("RÉSUMÉ DE L'EXPLORATION")
print("="*70)
print("\nFichiers traités et sauvegardés dans data/processed/:")
for f in sorted(PROCESSED_DIR.glob('*.csv')):
    size_mb = f.stat().st_size / (1024*1024)
    print(f"  - {f.name:40s} ({size_mb:.1f} MB)")

print(f"\nFigures générées dans figures/:")
for f in sorted(FIGURES_DIR.glob('01_*.png')):
    print(f"  - {f.name}")

print("\n✅ Exploration terminée!")
print("="*70)
