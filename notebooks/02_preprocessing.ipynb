# Cellule 2 : Chargement
print("\n📥 Chargement des données")

clinical = pd.read_csv(PROCESSED_DIR / 'clinical_raw.csv')

# Charger toutes les modalités disponibles
modalities = {}

# mRNA RSEM
if (PROCESSED_DIR / 'mrna_transposed.csv').exists():
    modalities['mrna'] = pd.read_csv(PROCESSED_DIR / 'mrna_transposed.csv', index_col=0)
    print(f"✅ mRNA: {modalities['mrna'].shape}")

# mRNA Agilent
if (PROCESSED_DIR / 'mrna_agilent_raw.csv').exists():
    modalities['mrna_agilent'] = pd.read_csv(PROCESSED_DIR / 'mrna_agilent_raw.csv', index_col=0)
    print(f"✅ mRNA Agilent: {modalities['mrna_agilent'].shape}")

# Méthylation
if (PROCESSED_DIR / 'methylation_transposed.csv').exists():
    modalities['methylation'] = pd.read_csv(PROCESSED_DIR / 'methylation_transposed.csv', index_col=0)
    print(f"✅ Méthylation: {modalities['methylation'].shape}")

# CNA
if (PROCESSED_DIR / 'cna_transposed.csv').exists():
    modalities['cna'] = pd.read_csv(PROCESSED_DIR / 'cna_transposed.csv', index_col=0)
    print(f"✅ CNA: {modalities['cna'].shape}")

# Mutations
if (PROCESSED_DIR / 'mutation_matrix.csv').exists():
    modalities['mutations'] = pd.read_csv(PROCESSED_DIR / 'mutation_matrix.csv', index_col=0)
    print(f"✅ Mutations: {modalities['mutations'].shape}")

# PANCAN
if (PROCESSED_DIR / 'pancan_brca_expression.csv').exists():
    modalities['pancan'] = pd.read_csv(PROCESSED_DIR / 'pancan_brca_expression.csv', index_col=0)
    print(f"✅ PANCAN BRCA: {modalities['pancan'].shape}")

print(f"\nTotal modalités chargées: {len(modalities)}")

# Cellule 3 : Création cible (SANS data leakage)
print("\n🎯 Création de la cible clinique")

def create_clinical_target(clinical_df):
    """Cible basée sur facteurs pré-opératoires connus"""
    df = clinical_df.copy()
    
    risk_factors = pd.DataFrame({
        'stage_advanced': df['TUMOR_STAGE'].isin(['Stage III', 'Stage IV']).astype(int) * 3,
        'grade_high': df['GRADE'].isin(['3', '4']).astype(int) * 2,
        'triple_negative': (
            (df['ER_STATUS'] == 'Negative') & 
            (df['PR_STATUS'] == 'Negative') & 
            (df['HER2_STATUS'] == 'Negative')
        ).astype(int) * 3,
        'her2_positive': (df['HER2_STATUS'] == 'Positive').astype(int) * 2,
        'age_risk': (df['AGE'] > 70).astype(int) * 1,
        'young_age': (df['AGE'] < 35).astype(int) * 1,
    })
    
    total_score = risk_factors.sum(axis=1)
    target = (total_score >= 4).astype(int)
    
    print(f"Distribution: {target.value_counts().to_dict()}")
    print(f"Mean risk score: {total_score.mean():.2f}")
    
    return target

y = create_clinical_target(clinical)

# Visualisation
plt.figure(figsize=(10, 6))
y.value_counts().plot(kind='bar', color=['lightblue', 'salmon'])
plt.title('Distribution de la cible (Risque chirurgical)')
